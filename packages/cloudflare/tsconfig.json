{
  "compilerOptions": {
    "declaration": true,
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "ES2024",
    "types": ["@cloudflare/workers-types"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
